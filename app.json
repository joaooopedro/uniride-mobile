{
  "expo": {
    "name": "UniRide",
    "slug": "uniride-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.joaooopedro.uniride"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFBFA"
      },
      "package": "com.joaooopedro.uniride"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#087E79"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.769246594269-gh55gq5obbf39v85mtgugqj2o6gnmdqa"
        }
      ]
    ],
    "scheme": "uniride"
  }
}
