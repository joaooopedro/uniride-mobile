rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function verificado() {
      return logado() && request.auth.token.email_verified == true;
    }

    function dono(uid) {
      return logado() && request.auth.uid == uid;
    }

    function soMudou(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function textoValido(valor, maximo) {
      return valor is string && valor.size() > 0 && valor.size() <= maximo;
    }

    // Perfil visível para alunos verificados: nome, curso, notas e veículo.
    match /usuarios/{uid} {
      allow read: if verificado() || dono(uid);

      allow create: if dono(uid)
        && request.resource.data.keys().hasOnly(['nome', 'curso', 'periodo', 'fotoBase64', 'ehMotorista', 'motorista', 'notaMotorista', 'notaPassageiro', 'viagens', 'criadoEm', 'atualizadoEm'])
        && textoValido(request.resource.data.nome, 80)
        && textoValido(request.resource.data.curso, 60)
        && request.resource.data.periodo is int
        && request.resource.data.ehMotorista == false
        && request.resource.data.notaMotorista == { 'soma': 0, 'total': 0 }
        && request.resource.data.notaPassageiro == { 'soma': 0, 'total': 0 }
        && request.resource.data.viagens == 0;

      // O dono edita os próprios dados, mas nunca as notas nem o contador de viagens.
      allow update: if dono(uid)
        && soMudou(['nome', 'curso', 'periodo', 'fotoBase64', 'ehMotorista', 'motorista', 'atualizadoEm'])
        && textoValido(request.resource.data.nome, 80)
        && (request.resource.data.fotoBase64 == null || request.resource.data.fotoBase64.size() < 300000);

      allow delete: if false;

      // Matrícula, e-mail, telefone e PIX: só o dono.
      match /privado/dados {
        allow read, write: if dono(uid);
      }
    }

    // Tudo que não foi liberado acima fica fechado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
